# Bee Loop local config — copy to .env.local (never commit secrets)

# Local Bee CLI proxy (default)
BEE_PROXY_URL=http://127.0.0.1:8787

# Use built-in fixtures instead of Bee hardware / proxy
# BEE_MOCK=1
# On Vercel, mock mode is automatic (Bee proxy is localhost-only).
# Force file vs memory store: BEE_STORE=memory | file (default: file locally, memory on Vercel)
# Disable demo seed on cold start: BEE_SEED=0

# Optional — improves study card + commitment extraction
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Agent CLI target (default http://127.0.0.1:3000)
# BEE_LOOP_URL=http://127.0.0.1:3000
